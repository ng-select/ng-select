{
	"$schema": "./node_modules/@angular/cli/lib/config/schema.json",
	"cli": {
		"analytics": false,
		"schematicCollections": ["@angular-eslint/schematics"]
	},
	"version": 1,
	"newProjectRoot": "src",
	"projects": {
		"ng-select": {
			"projectType": "library",
			"root": "src/ng-select",
			"sourceRoot": "src/ng-select",
			"prefix": "lib",
			"architect": {
				"build": {
					"builder": "@angular/build:ng-packagr",
					"options": {
						"tsConfig": "src/ng-select/tsconfig.lib.json",
						"project": "src/ng-select/ng-package.json"
					}
				},
				"test-build": {
					"builder": "@angular/build:application",
					"options": {
						"tsConfig": "src/ng-select/tsconfig.spec.json",
						"polyfills": []
					},
					"configurations": {
						"zone": {
							"polyfills": ["zone.js", "zone.js/testing", "zone.js/plugins/vitest-patch"]
						}
					}
				},
				"test": {
					"builder": "@angular/build:unit-test",
					"options": {
						"buildTarget": "ng-select:test-build",
						"runnerConfig": "vitest.config.ts",
						"coverage": true,
						"coverageExclude": [
							"src/ng-select/testing/*",
							"src/ng-select/*.ts",
							"src/ng-select/lib/console.service.ts",
							"src/ng-select/lib/search-helper.ts",
							"src/ng-select/lib/ng-templates.directive.ts"
						],
						"coverageReporters": ["html", "lcovonly", "text-summary"]
					}
				},
				"test-zone": {
					"builder": "@angular/build:unit-test",
					"options": {
						"buildTarget": "ng-select:test-build:zone",
						"runnerConfig": "vitest.config.ts",
						"coverage": false
					}
				},
				"lint": {
					"builder": "@angular-eslint/builder:lint",
					"options": {
						"lintFilePatterns": ["src/ng-select/**/*.ts", "src/ng-select/**/*.html"]
					}
				}
			}
		},
		"ng-option-highlight": {
			"projectType": "library",
			"root": "src/ng-option-highlight",
			"sourceRoot": "src/ng-option-highlight",
			"prefix": "lib",
			"architect": {
				"build": {
					"builder": "@angular/build:ng-packagr",
					"options": {
						"tsConfig": "src/ng-option-highlight/tsconfig.lib.json",
						"project": "src/ng-option-highlight/ng-package.json"
					}
				},
				"test-build": {
					"builder": "@angular/build:application",
					"options": {
						"tsConfig": "src/ng-option-highlight/tsconfig.spec.json",
						"polyfills": []
					},
					"configurations": {
						"zone": {
							"polyfills": ["zone.js", "zone.js/testing", "zone.js/plugins/vitest-patch"]
						}
					}
				},
				"test": {
					"builder": "@angular/build:unit-test",
					"options": {
						"buildTarget": "ng-option-highlight:test-build",
						"runnerConfig": "vitest.config.ts",
						"coverage": true,
						"coverageReporters": ["html", "lcovonly", "text-summary"]
					}
				},
				"test-zone": {
					"builder": "@angular/build:unit-test",
					"options": {
						"buildTarget": "ng-option-highlight:test-build:zone",
						"runnerConfig": "vitest.config.ts",
						"coverage": false
					}
				},
				"lint": {
					"builder": "@angular-eslint/builder:lint",
					"options": {
						"lintFilePatterns": ["src/ng-option-highlight/**/*.ts", "src/ng-option-highlight/**/*.html"]
					}
				}
			}
		}
	},
	"schematics": {
		"@schematics/angular:component": {
			"type": "component"
		},
		"@schematics/angular:directive": {
			"type": "directive"
		},
		"@schematics/angular:service": {
			"type": "service"
		},
		"@schematics/angular:guard": {
			"typeSeparator": "."
		},
		"@schematics/angular:interceptor": {
			"typeSeparator": "."
		},
		"@schematics/angular:module": {
			"typeSeparator": "."
		},
		"@schematics/angular:pipe": {
			"typeSeparator": "."
		},
		"@schematics/angular:resolver": {
			"typeSeparator": "."
		}
	}
}
