{
	"$schema": "./node_modules/@angular/cli/lib/config/schema.json",
	"cli": {
		"analytics": false,
		"schematicCollections": ["@angular-eslint/schematics"]
	},
	"version": 1,
	"newProjectRoot": "src",
	"projects": {
		"ng-select": {
			"projectType": "library",
			"root": "src/ng-select",
			"sourceRoot": "src/ng-select",
			"prefix": "lib",
			"architect": {
				"build": {
					"builder": "@angular/build:ng-packagr",
					"options": {
						"tsConfig": "src/ng-select/tsconfig.lib.json",
						"project": "src/ng-select/ng-package.json"
					}
				},
				"test-build": {
					"builder": "@angular/build:application",
					"options": {
						"tsConfig": "src/ng-select/tsconfig.spec.json",
						"polyfills": []
					},
					"configurations": {
						"zone": {
							"polyfills": ["zone.js", "zone.js/testing", "zone.js/plugins/vitest-patch"]
						}
					}
				},
				"test": {
					"builder": "@angular/build:unit-test",
					"options": {
						"buildTarget": "ng-select:test-build",
						"runnerConfig": "vitest.config.ts",
						"coverage": true,
						"coverageExclude": [
							"src/ng-select/testing/*",
							"src/ng-select/*.ts",
							"src/ng-select/lib/console.service.ts",
							"src/ng-select/lib/search-helper.ts",
							"src/ng-select/lib/ng-templates.directive.ts"
						],
						"coverageReporters": ["html", "lcovonly", "text-summary"]
					}
				},
				"test-zone": {
					"builder": "@angular/build:unit-test",
					"options": {
						"buildTarget": "ng-select:test-build:zone",
						"runnerConfig": "vitest.config.ts",
						"coverage": false
					}
				},
				"lint": {
					"builder": "@angular-eslint/builder:lint",
					"options": {
						"lintFilePatterns": ["src/ng-select/**/*.ts", "src/ng-select/**/*.html"]
					}
				}
			}
		},
		"demo": {
			"projectType": "application",
			"schematics": {
				"@schematics/angular:component": {
					"style": "scss",
					"skipTests": true
				},
				"@schematics/angular:class": {
					"skipTests": true
				},
				"@schematics/angular:directive": {
					"skipTests": true
				},
				"@schematics/angular:guard": {
					"skipTests": true
				},
				"@schematics/angular:module": {
					"skipTests": true
				},
				"@schematics/angular:pipe": {
					"skipTests": true
				},
				"@schematics/angular:service": {
					"skipTests": true
				}
			},
			"root": "src/demo",
			"sourceRoot": "src/demo",
			"prefix": "",
			"architect": {
				"build": {
					"builder": "@ng-doc/builder:application",
					"options": {
						"outputPath": {
							"base": "dist/demo"
						},
						"index": "src/demo/index.html",
						"polyfills": [],
						"tsConfig": "src/demo/tsconfig.app.json",
						"assets": [
							"src/demo/favicon.ico",
							{
								"glob": "**/*",
								"input": "src/demo/assets",
								"output": "assets"
							},
							{
								"glob": "**/*",
								"input": "src/demo/app/examples",
								"output": "examples"
							},
							{
								"glob": "**/*",
								"input": "node_modules/@ng-doc/app/assets",
								"output": "assets/ng-doc/app"
							},
							{
								"glob": "**/*",
								"input": "node_modules/@ng-doc/ui-kit/assets",
								"output": "assets/ng-doc/ui-kit"
							},
							{
								"glob": "**/*",
								"input": "ng-doc/demo/assets",
								"output": "assets/ng-doc"
							}
						],
						"styles": ["node_modules/@ng-doc/app/styles/global.css", "node_modules/@ng-doc/app/styles/themes/dark.css", "src/demo/styles.scss"],
						"allowedCommonJsDependencies": ["@ng-doc/core"],
						"browser": "src/demo/main.ts"
					},
					"configurations": {
						"production": {
							"baseHref": "/ng-select/",
							"outputHashing": "all",
							"budgets": [
								{
									"type": "initial",
									"maximumWarning": "4mb",
									"maximumError": "6mb"
								},
								{
									"type": "anyComponentStyle",
									"maximumWarning": "100kb"
								}
							]
						},
						"development": {
							"optimization": false,
							"extractLicenses": false,
							"sourceMap": true
						}
					},
					"defaultConfiguration": "development"
				},
				"serve": {
					"builder": "@ng-doc/builder:dev-server",
					"options": {
						"buildTarget": "demo:build"
					},
					"configurations": {
						"production": {
							"buildTarget": "demo:build:production"
						}
					}
				}
			}
		},
		"ng-option-highlight": {
			"projectType": "library",
			"root": "src/ng-option-highlight",
			"sourceRoot": "src/ng-option-highlight",
			"prefix": "lib",
			"architect": {
				"build": {
					"builder": "@angular/build:ng-packagr",
					"options": {
						"tsConfig": "src/ng-option-highlight/tsconfig.lib.json",
						"project": "src/ng-option-highlight/ng-package.json"
					}
				},
				"test-build": {
					"builder": "@angular/build:application",
					"options": {
						"tsConfig": "src/ng-option-highlight/tsconfig.spec.json",
						"polyfills": []
					},
					"configurations": {
						"zone": {
							"polyfills": ["zone.js", "zone.js/testing", "zone.js/plugins/vitest-patch"]
						}
					}
				},
				"test": {
					"builder": "@angular/build:unit-test",
					"options": {
						"buildTarget": "ng-option-highlight:test-build",
						"runnerConfig": "vitest.config.ts",
						"coverage": true,
						"coverageReporters": ["html", "lcovonly", "text-summary"]
					}
				},
				"test-zone": {
					"builder": "@angular/build:unit-test",
					"options": {
						"buildTarget": "ng-option-highlight:test-build:zone",
						"runnerConfig": "vitest.config.ts",
						"coverage": false
					}
				},
				"lint": {
					"builder": "@angular-eslint/builder:lint",
					"options": {
						"lintFilePatterns": ["src/ng-option-highlight/**/*.ts", "src/ng-option-highlight/**/*.html"]
					}
				}
			}
		}
	},
	"schematics": {
		"@schematics/angular:component": {
			"type": "component"
		},
		"@schematics/angular:directive": {
			"type": "directive"
		},
		"@schematics/angular:service": {
			"type": "service"
		},
		"@schematics/angular:guard": {
			"typeSeparator": "."
		},
		"@schematics/angular:interceptor": {
			"typeSeparator": "."
		},
		"@schematics/angular:module": {
			"typeSeparator": "."
		},
		"@schematics/angular:pipe": {
			"typeSeparator": "."
		},
		"@schematics/angular:resolver": {
			"typeSeparator": "."
		}
	}
}
